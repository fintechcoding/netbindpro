<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>NetBindPro.Core</AssemblyName>
    <RootNamespace>NetBindPro.Core</RootNamespace>
    <Platforms>x86;x64</Platforms>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <PackageId>NetBindPro.Core</PackageId>
    <Description>Core models, services and adapter discovery for NetBind Pro</Description>
    <NoWarn>CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="8.0.1" />
    <PackageReference Include="System.Text.Json"                          Version="8.0.5" />
  </ItemGroup>

</Project>
