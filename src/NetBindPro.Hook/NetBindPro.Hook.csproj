<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <AssemblyName>NetBindPro.Hook</AssemblyName>
    <RootNamespace>NetBindPro.Hook</RootNamespace>
    <Platforms>x86;x64</Platforms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Injection engine for NetBind Pro</Description>
    <SelfContained>false</SelfContained>
    <!-- Suppress XML doc and nullable warnings for injection code -->
    <NoWarn>CS1591;CS8602;CS8604</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetBindPro.Core\NetBindPro.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      EasyHook: the correct NuGet package ID is exactly "EasyHook".
      Latest stable version on NuGet.org is 2.27.0.0.
      If NuGet cannot resolve it, download manually from:
      https://www.nuget.org/packages/EasyHook/2.27.0.0
      or use the GitHub release: https://github.com/EasyHook/EasyHook/releases
    -->
    <PackageReference Include="EasyHook" Version="2.7.7097" />

    <!--
      System.CommandLine: still in preview. If this version is unavailable,
      replace with: Version="2.0.0-beta4.22272.1"
    -->
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

</Project>
