<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!--
      .NET Framework 4.8 — EasyHook can only inject a .NET Framework payload
      (it hosts the Framework CLR inside the target process). Shipping the Hook
      as net48 is what makes injection actually work. net48 is present on all
      supported Windows 10/11 installs, so nothing extra needs bundling.
    -->
    <TargetFramework>net48</TargetFramework>
    <AssemblyName>NetBindPro.Hook</AssemblyName>
    <RootNamespace>NetBindPro.Hook</RootNamespace>
    <Platforms>x86;x64</Platforms>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Description>Injection engine for NetBind Pro</Description>
    <!-- Suppress XML doc and nullable warnings for injection code -->
    <NoWarn>CS1591;CS8602;CS8604;CS8600;CS8601;CS8618;NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- EasyHook ships its native loaders (EasyHook32/64.dll, EasyLoad*, *Svc.exe)
         as contentFiles that copy to the output folder for a .NET Framework TFM. -->
    <PackageReference Include="EasyHook" Version="2.7.7097" />
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
    <!-- Lets the .NET SDK build this net48 project without a machine-wide
         .NET Framework targeting pack (needed on clean CI runners). -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
