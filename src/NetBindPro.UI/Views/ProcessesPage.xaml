<Page x:Class="NetBindPro.UI.Views.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg0Brush}" Title="Processes">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg0Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="56">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Running Processes" Style="{StaticResource TextHeading}"/>
                    <Border Background="{StaticResource AccentDimBrush}" CornerRadius="10"
                            Padding="8,2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock x:Name="CountBadge" Text="0"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" Content="Refresh"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click"/>
            </Grid>
        </Border>
        <!-- Column headers -->
        <Grid DockPanel.Dock="Top" Height="36" Background="{StaticResource Bg1Brush}">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="60"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="PROCESS" Style="{StaticResource TextLabel}"
                           VerticalAlignment="Center" Margin="4,0"/>
                <TextBlock Grid.Column="1" Text="PID"     Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="2" Text="ARCH"    Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="ACTION"  Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        <ScrollViewer>
            <ItemsControl x:Name="ProcessList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                Padding="0,0">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Height="38" Margin="24,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Name}"
                                           FontFamily="Consolas" FontSize="12"
                                           Foreground="{StaticResource Text1Brush}" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1" Text="{Binding PidText}"
                                           FontFamily="Consolas" FontSize="11"
                                           Foreground="{StaticResource Text3Brush}" VerticalAlignment="Center"/>
                                <Border Grid.Column="2" CornerRadius="3" Padding="6,2"
                                        Background="{StaticResource Bg2Brush}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Arch}" FontSize="10" FontWeight="SemiBold"
                                               Foreground="{StaticResource Text2Brush}"/>
                                </Border>
                                <Button Grid.Column="3" Style="{StaticResource GhostButton}"
                                        Content="Inject" FontSize="11" Padding="10,3"
                                        VerticalAlignment="Center" Click="Inject_Click"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>
