<Window x:Class="NetBindPro.UI.Views.AddRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Binding Rule" Height="560" Width="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border CornerRadius="10" Background="White"
            BorderBrush="#D0D0D0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="28,18">
                <Grid>
                    <TextBlock Text="Add Binding Rule" FontSize="17" FontWeight="SemiBold"
                               Foreground="#1A1A1A"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="Cancel_Click">
                        <TextBlock Text="&#xE106;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="#999"/>
                    </Button>
                </Grid>
            </Border>
            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg1Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="28,16"
                    CornerRadius="0,0,10,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="Cancel"
                            Click="Cancel_Click" Margin="0,0,12,0"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="Add Rule" Click="Save_Click"/>
                </StackPanel>
            </Border>
            <!-- Body -->
            <ScrollViewer Margin="28,20,28,10" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Process name -->
                    <TextBlock Text="PROCESS NAME" FontSize="10" FontWeight="SemiBold"
                               Foreground="#999" Margin="0,0,0,6"/>
                    <TextBox x:Name="ProcessNameBox" Height="38"
                             ToolTip="e.g. firefox.exe"/>
                    <TextBlock Text="Enter the .exe filename. Case-insensitive."
                               FontSize="11" Foreground="#999" Margin="2,5,0,20"/>

                    <!-- Process path -->
                    <TextBlock Text="PROCESS PATH (OPTIONAL)" FontSize="10" FontWeight="SemiBold"
                               Foreground="#999" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ProcessPathBox" Height="38" Grid.Column="0"/>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                Content="Browse" Margin="10,0,0,0" Click="Browse_Click"/>
                    </Grid>
                    <TextBlock Text="Specify a full path to distinguish same-named processes."
                               FontSize="11" Foreground="#999" Margin="2,5,0,20" TextWrapping="Wrap"/>

                    <!-- Adapter selection -->
                    <TextBlock Text="NETWORK ADAPTER" FontSize="10" FontWeight="SemiBold"
                               Foreground="#999" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="AdapterList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" CornerRadius="8" Padding="14,12"
                                        BorderThickness="1.5" Cursor="Hand"
                                        BorderBrush="{Binding BorderBrush}"
                                        Background="{Binding Background}"
                                        MouseLeftButtonDown="AdapterItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8"
                                                 Fill="{Binding DotColor}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Adapter.Name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#1A1A1A"/>
                                                <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                        Background="{Binding BadgeBackground}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="9"
                                                               FontWeight="Bold" Foreground="{Binding BadgeText}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Adapter.IpV4Address}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="#999" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE73E;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSelectedVisibility}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Auto inject -->
                    <Border Background="{StaticResource Bg1Brush}" CornerRadius="8"
                            Padding="14,12" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="AutoInjectCheck" Style="{StaticResource ToggleCheckBox}"
                                      IsChecked="True" VerticalAlignment="Center"/>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Auto-inject on process start"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                                <TextBlock Text="Automatically bind when this process launches"
                                           FontSize="11" Foreground="#999"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <TextBlock Text="NOTES (OPTIONAL)" FontSize="10" FontWeight="SemiBold"
                               Foreground="#999" Margin="0,20,0,6"/>
                    <TextBox x:Name="NotesBox" Height="60"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"/>

                    <FrameworkElement Height="10"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
