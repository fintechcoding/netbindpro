<Window x:Class="NetBindPro.UI.Views.AddRuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add Binding Rule" Height="710" Width="520"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <Border CornerRadius="10" Background="White"
            BorderBrush="#D0D0D0" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="30" ShadowDepth="4" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,0,1" Padding="28,18">
                <Grid>
                    <TextBlock x:Name="HeaderText" Text="Add Binding Rule" FontSize="17" FontWeight="SemiBold"
                               Foreground="#1A1A1A"/>
                    <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Click="Cancel_Click">
                        <TextBlock Text="&#xE106;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="#999"/>
                    </Button>
                </Grid>
            </Border>
            <!-- Footer -->
            <Border DockPanel.Dock="Bottom" Background="{StaticResource Bg1Brush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,1,0,0" Padding="28,16"
                    CornerRadius="0,0,10,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource GhostButton}" Content="Cancel"
                            Click="Cancel_Click" Margin="0,0,12,0"/>
                    <Button x:Name="SaveButton" Style="{StaticResource PrimaryButton}" Content="Add Rule" Click="Save_Click"/>
                </StackPanel>
            </Border>
            <!-- Body -->
            <ScrollViewer Margin="28,20,28,10" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <!-- Process picker -->
                    <TextBlock Text="PROCESS" FontSize="10" FontWeight="SemiBold"
                               Foreground="#999" Margin="0,0,0,6"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0">
                            <TextBox x:Name="SearchBox" Height="38" TextChanged="SearchBox_TextChanged"/>
                            <TextBlock x:Name="SearchPlaceholder"
                                       Text="Search running processes, or type an .exe name…"
                                       Foreground="#B0B0B0" FontSize="13" Margin="12,0,0,0"
                                       VerticalAlignment="Center" IsHitTestVisible="False"/>
                        </Grid>
                        <Button Grid.Column="1" Style="{StaticResource GhostButton}"
                                Content="Browse" Margin="10,0,0,0" Click="Browse_Click"/>
                    </Grid>

                    <!-- Running process list -->
                    <Border Margin="0,8,0,0" CornerRadius="8" BorderThickness="1"
                            BorderBrush="#E0E0E0" Background="White">
                        <ListBox x:Name="ProcessPickList" Height="190" BorderThickness="0"
                                 Background="Transparent" Padding="4"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 SelectionChanged="ProcessPickList_SelectionChanged">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="2,2"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" CornerRadius="6" Padding="8,7"
                                                        Background="Transparent" BorderThickness="1.5"
                                                        BorderBrush="Transparent" Cursor="Hand">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#F5F5F5"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#12FF6633"/>
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="#FF6633"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="30" Height="30" CornerRadius="6"
                                                Background="{Binding IconBackground}">
                                            <TextBlock Text="{Binding Initial}" FontWeight="Bold" FontSize="12"
                                                       Foreground="{Binding IconForeground}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                       Foreground="#1A1A1A"/>
                                            <TextBlock Text="{Binding PathDisplay}" FontSize="10" Foreground="#AAA"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <Border Grid.Column="2" CornerRadius="9" Padding="7,2" Background="#F0F0F0"
                                                VerticalAlignment="Center" Visibility="{Binding CountVisibility}">
                                            <TextBlock Text="{Binding CountText}" FontSize="10"
                                                       FontWeight="SemiBold" Foreground="#888"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                    <TextBlock Text="Pick a running process, or type its .exe name to also match future launches."
                               FontSize="11" Foreground="#999" Margin="2,6,0,20" TextWrapping="Wrap"/>

                    <!-- Adapter selection -->
                    <TextBlock Text="NETWORK ADAPTER" FontSize="10" FontWeight="SemiBold"
                               Foreground="#999" Margin="0,0,0,8"/>
                    <ItemsControl x:Name="AdapterList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" CornerRadius="8" Padding="14,12"
                                        BorderThickness="1.5" Cursor="Hand"
                                        BorderBrush="{Binding BorderBrush}"
                                        Background="{Binding Background}"
                                        MouseLeftButtonDown="AdapterItem_Click">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Grid.Column="0" Width="8" Height="8"
                                                 Fill="{Binding DotColor}" VerticalAlignment="Center"/>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Adapter.Name}"
                                                           FontSize="13" FontWeight="SemiBold"
                                                           Foreground="#1A1A1A"/>
                                                <Border CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                                        Background="{Binding BadgeBackground}" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding KindLabel}" FontSize="9"
                                                               FontWeight="Bold" Foreground="{Binding BadgeText}"/>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Adapter.IpV4Address}"
                                                       FontFamily="Consolas" FontSize="11"
                                                       Foreground="#999" Margin="0,3,0,0"/>
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="&#xE73E;"
                                                   FontFamily="Segoe MDL2 Assets" FontSize="16"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   VerticalAlignment="Center"
                                                   Visibility="{Binding IsSelectedVisibility}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Tunnel exit IP check -->
                    <Border Margin="0,10,0,0" CornerRadius="8" Background="{StaticResource Bg1Brush}"
                            BorderBrush="#E0E0E0" BorderThickness="1" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,10,0">
                                <TextBlock Text="Tunnel exit IP" FontSize="12" FontWeight="SemiBold"
                                           Foreground="#1A1A1A"/>
                                <TextBlock x:Name="EgressResultText"
                                           Text="Select an adapter above, then verify its public exit IP."
                                           FontSize="11" Foreground="#999" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                            <Button x:Name="CheckIpButton" Grid.Column="1"
                                    Style="{StaticResource GhostButton}" Content="Check IP"
                                    VerticalAlignment="Center" Click="CheckIp_Click"/>
                        </Grid>
                    </Border>

                    <!-- Auto inject -->
                    <Border Background="{StaticResource Bg1Brush}" CornerRadius="8"
                            Padding="14,12" Margin="0,14,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="AutoInjectCheck" Style="{StaticResource ToggleCheckBox}"
                                      IsChecked="True" VerticalAlignment="Center"/>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Auto-inject on process start"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                                <TextBlock Text="Automatically bind when this process launches"
                                           FontSize="11" Foreground="#999"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Kill switch -->
                    <Border Background="{StaticResource Bg1Brush}" CornerRadius="8"
                            Padding="14,12" Margin="0,10,0,0">
                        <StackPanel Orientation="Horizontal">
                            <CheckBox x:Name="KillSwitchCheck" Style="{StaticResource ToggleCheckBox}"
                                      IsChecked="True" VerticalAlignment="Center"/>
                            <StackPanel Margin="4,0,0,0">
                                <TextBlock Text="Kill-switch (no leak)"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#1A1A1A"/>
                                <TextBlock Text="Block this app from the internet if its adapter/tunnel is down"
                                           FontSize="11" Foreground="#999" TextWrapping="Wrap"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Notes -->
                    <TextBlock Text="NOTES (OPTIONAL)" FontSize="10" FontWeight="SemiBold"
                               Foreground="#999" Margin="0,20,0,6"/>
                    <TextBox x:Name="NotesBox" Height="60"
                             AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                             VerticalContentAlignment="Top"/>

                    <FrameworkElement Height="10"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
