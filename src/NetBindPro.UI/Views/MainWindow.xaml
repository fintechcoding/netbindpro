<Window x:Class="NetBindPro.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="NetBind Pro" Height="680" Width="960"
        MinHeight="560" MinWidth="760"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="CanResizeWithGrip">
    <Border CornerRadius="8" Background="{StaticResource Bg0Brush}"
            BorderBrush="{StaticResource Border2Brush}" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="28"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Border Grid.Row="0" Background="{StaticResource Bg0Brush}"
                    CornerRadius="8,8,0,0"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <!-- App icon -->
                        <Border Width="22" Height="22" CornerRadius="4" Background="{StaticResource AccentBrush}">
                            <TextBlock Text="N" FontSize="12" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="NetBind Pro" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource Text1Brush}"
                                   VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <!-- Window controls -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button Style="{StaticResource ChromeButton}" Click="Minimize_Click"
                                Content="&#xE949;" ToolTip="Minimize"/>
                        <Button Style="{StaticResource ChromeButton}" Click="Maximize_Click"
                                Content="&#xE739;" ToolTip="Maximize"/>
                        <Button Style="{StaticResource ChromeCloseButton}" Click="Close_Click"
                                Content="&#xE106;" ToolTip="Close"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main content -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Sidebar -->
                <Border Grid.Column="0" Background="{StaticResource Bg1Brush}"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="v2.0.0"
                                   HorizontalAlignment="Center" Margin="0,0,0,12"
                                   FontFamily="Segoe UI" FontSize="10"
                                   Foreground="{StaticResource Text3Brush}"/>
                        <StackPanel Margin="8,10,8,0">
                            <Button Style="{StaticResource NavButton}" Tag="Rules" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{StaticResource Text3Brush}"/>
                                    <TextBlock Text="Rules" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Tag="Adapters" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{StaticResource Text3Brush}"/>
                                    <TextBlock Text="Adapters" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Tag="Tunnels" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{StaticResource Text3Brush}"/>
                                    <TextBlock Text="Tunnels" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Tag="Processes" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{StaticResource Text3Brush}"/>
                                    <TextBlock Text="Processes" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Separator Margin="8,6"/>
                            <Button Style="{StaticResource NavButton}" Tag="Log" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{StaticResource Text3Brush}"/>
                                    <TextBlock Text="Log" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource NavButton}" Tag="Settings" Click="Nav_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Margin="0,0,10,0"
                                               Foreground="{StaticResource Text3Brush}"/>
                                    <TextBlock Text="Settings" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Page content -->
                <Frame Grid.Column="1" x:Name="PageFrame"
                       NavigationUIVisibility="Hidden"
                       Background="{StaticResource Bg0Brush}"/>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{StaticResource Bg1Brush}"
                    CornerRadius="0,0,8,8"
                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
                <Grid Margin="16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}" Margin="0,0,6,0"/>
                        <TextBlock x:Name="StatusRules" Text="0 rules active"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Foreground="{StaticResource Text3Brush}"/>
                        <TextBlock Text="  |  " Foreground="{StaticResource Bg4Brush}" FontSize="11"/>
                        <TextBlock x:Name="StatusInjections" Text="0 injections"
                                   FontFamily="Segoe UI" FontSize="11"
                                   Foreground="{StaticResource Text3Brush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="StatusWireGuard" FontFamily="Segoe UI"
                                   FontSize="11" Foreground="{StaticResource Text3Brush}" Margin="0,0,14,0"/>
                        <TextBlock x:Name="StatusTailscale" FontFamily="Segoe UI"
                                   FontSize="11" Foreground="{StaticResource Text3Brush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
