<Page x:Class="NetBindPro.UI.Views.RulesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg0Brush}" Title="Rules">
    <DockPanel>
        <!-- Top action bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg0Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="56">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Binding Rules" Style="{StaticResource TextHeading}"/>
                    <Border Background="{StaticResource AccentDimBrush}" CornerRadius="10"
                            Padding="8,2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock x:Name="RuleCountBadge" Text="0"
                                   FontFamily="Segoe UI" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBox x:Name="SearchBox" Width="200" Height="32"
                             Margin="0,0,10,0" TextChanged="SearchBox_TextChanged"
                             ToolTip="Search rules..."/>
                    <Button Style="{StaticResource GhostButton}" Content="Refresh"
                            Margin="0,0,10,0" Click="Refresh_Click"/>
                    <Button Style="{StaticResource PrimaryButton}" Content="+ Add Rule"
                            Click="AddRule_Click"/>
                </StackPanel>
            </Grid>
        </Border>
        <!-- Column headers -->
        <Grid DockPanel.Dock="Top" Height="36" Background="{StaticResource Bg1Brush}" Margin="0,0">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="36"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="100"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="PROCESS" Style="{StaticResource TextLabel}"
                           VerticalAlignment="Center" Margin="4,0"/>
                <TextBlock Grid.Column="2" Text="ADAPTER" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="3" Text="STATUS"  Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="4" Text="ACTIONS" Style="{StaticResource TextLabel}" VerticalAlignment="Center"/>
            </Grid>
        </Grid>
        <!-- Rules list -->
        <ScrollViewer DockPanel.Dock="Top">
            <ItemsControl x:Name="RulesList" ItemsSource="{Binding Rules}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                                Background="Transparent">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Bg1Brush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid Margin="24,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="200"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <!-- Icon -->
                                <Border Grid.Column="0" Width="28" Height="28" CornerRadius="6"
                                        Background="{Binding IconBackground}">
                                    <TextBlock Text="{Binding IconText}" FontSize="10" FontWeight="Bold"
                                               Foreground="{Binding IconForeground}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <!-- Process info -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding Rule.ProcessName}"
                                               Style="{StaticResource TextBase}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SubText}" Style="{StaticResource TextHint}"/>
                                </StackPanel>
                                <!-- Adapter tag -->
                                <Border Grid.Column="2" CornerRadius="4" Padding="8,3"
                                        Background="{Binding AdapterTagBackground}"
                                        VerticalAlignment="Center" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="6" Height="6" Fill="{Binding AdapterDotColor}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Rule.AdapterName}" Margin="6,0,0,0"
                                                   FontSize="12" FontWeight="SemiBold"
                                                   Foreground="{Binding AdapterTextColor}"/>
                                    </StackPanel>
                                </Border>
                                <!-- Toggle -->
                                <CheckBox Grid.Column="3" Style="{StaticResource ToggleCheckBox}"
                                          IsChecked="{Binding Rule.IsEnabled, Mode=TwoWay}"
                                          VerticalAlignment="Center"
                                          Command="{Binding ToggleCommand}"/>
                                <!-- Actions -->
                                <StackPanel Grid.Column="4" Orientation="Horizontal"
                                            VerticalAlignment="Center" HorizontalAlignment="Right">
                                    <Button Style="{StaticResource IconButton}" ToolTip="Launch bound — start this app through the adapter"
                                            Command="{Binding InjectCommand}" Margin="0,0,2,0">
                                        <TextBlock Text="&#xE768;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{StaticResource AccentBrush}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Verify — is this app's traffic actually going through the adapter?"
                                            Command="{Binding VerifyCommand}" Margin="0,0,2,0">
                                        <TextBlock Text="&#xE9D5;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{StaticResource Text2Brush}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Edit"
                                            Command="{Binding EditCommand}" Margin="0,0,2,0">
                                        <TextBlock Text="&#xE70F;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{StaticResource Text3Brush}"/>
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" ToolTip="Delete"
                                            Command="{Binding DeleteCommand}">
                                        <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="12" Foreground="{StaticResource RedBrush}"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>
