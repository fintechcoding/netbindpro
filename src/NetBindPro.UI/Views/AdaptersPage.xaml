<Page x:Class="NetBindPro.UI.Views.AdaptersPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource Bg0Brush}"
      Title="Adapters">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource Bg0Brush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Height="56">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Network Adapters" Style="{StaticResource TextHeading}"/>
                    <Border Background="{StaticResource AccentDimBrush}" CornerRadius="10"
                            Padding="8,2" VerticalAlignment="Center" Margin="10,0,0,0">
                        <TextBlock x:Name="CountBadge" Text="0" FontFamily="Segoe UI"
                                   FontSize="11" FontWeight="SemiBold"
                                   Foreground="{StaticResource AccentBrush}"/>
                    </Border>
                </StackPanel>
                <Button Style="{StaticResource GhostButton}" Content="Refresh"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Click="Refresh_Click"/>
            </Grid>
        </Border>
        <ScrollViewer>
            <ItemsControl x:Name="AdapterGrid" Margin="20">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="280" Margin="6" CornerRadius="8"
                                Background="{StaticResource Bg0Brush}"
                                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                Padding="16,14">
                            <Grid>
                                <Border HorizontalAlignment="Left" Width="3" CornerRadius="2"
                                        Background="{Binding AccentColor}" Margin="-16,-14,0,-14"/>
                                <StackPanel Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Adapter.Name}"
                                                   Style="{StaticResource TextBase}" FontWeight="SemiBold"/>
                                        <Border CornerRadius="3" Padding="6,1" Margin="8,0,0,0"
                                                Background="{Binding BadgeBackground}" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding KindLabel}" FontSize="9"
                                                       FontWeight="Bold" Foreground="{Binding AccentColor}"/>
                                        </Border>
                                    </StackPanel>
                                    <TextBlock FontFamily="Consolas" FontSize="12" Margin="0,6,0,0"
                                               Foreground="{StaticResource Text2Brush}"
                                               Text="{Binding Adapter.IpV4Address, TargetNullValue='No IPv4'}"/>
                                    <TextBlock FontFamily="Consolas" FontSize="10" Margin="0,2,0,0"
                                               Foreground="{StaticResource Text3Brush}"
                                               Text="{Binding Adapter.IpV6Address}"
                                               Visibility="{Binding HasIpV6Visibility}"/>
                                    <TextBlock Text="{Binding Adapter.Description}"
                                               Style="{StaticResource TextHint}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Ellipse Width="7" Height="7" Fill="{StaticResource GreenBrush}"
                                                 VerticalAlignment="Center"/>
                                        <TextBlock Text="Active" Margin="6,0,0,0"
                                                   FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource GreenBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Page>
